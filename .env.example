NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
LLM_PROVIDER=nvidia-nim
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY=
# Optional OpenAI-compatible endpoint override. NVIDIA NIM default:
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Clerk authentication (required; no anonymous fallback)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/projects

# Guided model deployment pilot (enable only after completing docs/model-deployment-setup.md)
GUIDED_DEPLOYMENT_ENABLED=false
# Set false for CPU-only evaluation of existing model APIs.
MODELLEDGER_DEPLOY_GPU=true
SUPABASE_SERVICE_ROLE_KEY=
MODEL_CREDENTIAL_KEY_V1=
MODAL_CONTROL_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Private Cloudflare R2 model uploads. Same configuration on the web server and Modal worker.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=model-artifacts

# Optional legacy operator-managed custom API. Credentials are restricted to this origin.
CUSTOM_MODEL_BASE_URL=
CUSTOM_MODEL_API_KEY=
